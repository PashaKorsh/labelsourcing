# Шаблон окружения фронтенда. Скопируй в frontend/.env и при необходимости поправь.

# База адресов API. Пусто = тот же origin. Для локального dev-сервера обычно http://localhost
VITE_API_URL=

# real — работать с настоящим бэкендом; mock — заглушки без бэкенда
VITE_API_MODE=real

# true — показывать DEV-инструменты в UI (быстрый вход, редактор сырых настроек)
VITE_DEV_PANEL=true
