# Шаблон окружения бэкенда. Скопируй в backend/.env и заполни значения.

# Подключение к PostgreSQL (async-драйвер). В docker-compose хост — имя сервиса db.
DATABASE_URL=postgresql+asyncpg://test:test@db:5432/testdb

# Ключ подписи JWT — заменить на длинную случайную строку
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Яндекс OAuth (значения — из кабинета приложения Яндекс OAuth)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost/api/v1/auth/yandex/callback

# true — включает вход через /auth/dev-login без OAuth (только для разработки)
DEV_MODE=true
